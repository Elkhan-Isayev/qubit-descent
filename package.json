{
  "name": "qubit-descent",
  "private": true,
  "version": "0.1.0",
  "description": "A continuous zoom into a quantum computer, from the dilution refrigerator down to a single phosphorus atom, showing how each part is made",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": ".venv-metal/bin/python -m pytest tests/python -q",
    "test:all": "npm test && npm run test:py"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "vite": "^8.3.1",
    "vitest": "^3.2.7"
  },
  "homepage": "https://elkhan-isayev.github.io/qubit-descent/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elkhan-Isayev/qubit-descent.git"
  },
  "author": "Elkhan Isayev",
  "engines": {
    "node": ">=22.12"
  }
}
